# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/CREDENTIALS.local.txt
/deploy/tls/*
!/deploy/tls/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files; keep the placeholder template
.env
.env.*
!.env.example

# local runtime logs
/logs/

# berkas dokumen runtime (BANGSIT PDF, unggahan kejadian)
/uploads/

# penanda waktu pengumpulan log sesi
.catatan-terakhir

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
